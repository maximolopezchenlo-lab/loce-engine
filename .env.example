# LiveVoice Open-Caption Engine (LOCE) Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=production

# Transcription Engine Provider
# Options: 'gemini' | 'mock'
DEFAULT_PROVIDER=gemini

# Google Gemini API Key (Required when DEFAULT_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.5-transcribe-live

# Audio Ingestion Defaults
DEFAULT_SAMPLE_RATE=16000
DEFAULT_CHANNELS=1
DEFAULT_CHUNK_MS=200

# PubSub Configuration
# Leave empty for in-memory broker, or supply redis:// URL for cluster scaling
REDIS_URL=
